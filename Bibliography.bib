@article{tremblay_cournot_2023,
	title = {Cournot platform competition with mixed-homing},
	volume = {91},
	issn = {0167-7187},
	url = {https://www.sciencedirect.com/science/article/pii/S0167718723000838},
	doi = {10.1016/j.ijindorg.2023.103002},
	abstract = {Competition in quantity dates back to Cournot (1838) for traditional markets and Katz and Shapiro (1985) for markets with direct network effects. In this paper, we consider Cournot platform competition in two-sided markets with indirect network effects while allowing for single-, multi-, and mixed-homing allocations. We find that the markup and markdown terms that are typically found in monopoly two-sided pricing are distorted toward zero when platform competition intensifies. We also generalize the monopoly platform Lerner indices from Armstrong (2006) and Weyl (2010) to include competition and mixed-homing allocations. Lastly, we show that welfare decreases in the number of platforms for the most commonly considered homing allocations, highlighting how the welfare loss from breaking up a network across smaller platforms can outweigh the welfare benefits from lower aggregate prices in a setting where platforms are homogenous.},
	urldate = {2025-08-06},
	journal = {International Journal of Industrial Organization},
	author = {Tremblay, Mark J. and Adachi, Takanori and Sato, Susumu},
	month = dec,
	year = {2023},
	keywords = {Network externalities, Lerner index, Multi-homing, Single-homing, Two-sided markets},
	pages = {103002},
